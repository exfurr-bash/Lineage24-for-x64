# Lineage24-for-x64 — configuração local
#
# Copie para config.env e ajuste os caminhos que quiser. O arquivo é carregado
# por scripts/lib/common.sh antes dos defaults. Valores definidos aqui
# substituem os mesmos nomes vindos do ambiente; os defaults só preenchem
# variáveis ainda não definidas.
#
# Este arquivo NÃO deve ser versionado (está no .gitignore).

# ------------------------------- diretórios -------------------------------
# Por padrão, tudo fica dentro do clone do projeto.
# CACHE_DIR="$PROJECT_ROOT/cache"
# WORKSPACE_DIR="$PROJECT_ROOT/workspace"
# DIST_DIR="$PROJECT_ROOT/dist"
# BACKUP_DIR="$PROJECT_ROOT/backups"
# LOG_DIR="$PROJECT_ROOT/logs"
# TMPROOT="$HOME/tmp/opencode"

# ------------------------------- release base -----------------------------
# Release pinado do upstream. NÃO mude para 20261122 sem ler
# docs/MIGRATION-20261122.md: o kernel muda de 7.2 para 7.3 e os fixes
# precisam ser revalidados.
BASE_RELEASE=20261020

# ------------------------------- kernel -----------------------------------
# Clone de android.googlesource.com/kernel/common (android-mainline).
# KERNEL_SRC="$PROJECT_ROOT/workspace/kernel/common"
# Clone de tiann/KernelSU na tag v3.3.1.
# KSU_REPO="$PROJECT_ROOT/workspace/kernel/KernelSU"
# Patches LineageOS (topic mainline-kernel).
# PATCHES_DIR="$PROJECT_ROOT/workspace/kernel/patches"
# Config do kernel stock da ISO baixada, extraída com extract-ikconfig.
# REFCONFIG="$PROJECT_ROOT/workspace/kernel/config/kernel-current.config"
# OUT_DIR="$PROJECT_ROOT/workspace/kernel/out"
# MODSTAGE_DIR="$PROJECT_ROOT/workspace/kernel/modstaging"

# ------------------------------- device -----------------------------------
# Ponto de montagem da partição da instalação (SSD/pendrive).
# ANDROID_PART=""            # ex.: /dev/nvme0n1p7; vazio = não instalar
# ANDROID_MOUNT="$HOME/mnt/android"
# GRUB_CFG=""                # ex.: /boot/efi/EFI/.../grub.cfg

# ------------------------------- ferramentas ------------------------------
# Diretório com mkfs.erofs/fsck.erofs/dump.erofs (build próprio ou erofs-utils).
# EROFS_BIN=""               # vazio = procura no PATH e em ./tools/erofs/bin
# RUST_TOOLCHAIN=1.93.1
# CLANG="clang"
# JOBS=                       # vazio = nproc (com guarda de memória/swap)

# ------------------------------- parâmetros -------------------------------
KVER=7.2.0+
KSU_TAG=v3.3.1
BT_MODULES="bluetooth btmtk btrtl btintel btbcm btusb"
GAPPS_MARKER="product/priv-app/Phonesky"

# QEMU (teste de regressão)
QEMU_MEM=3072
QEMU_CPUS=4
QEMU_TIMEOUT=180
